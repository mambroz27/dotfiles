{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "palette": {
    "bg": "#1a1b26",
    "bg_alt": "#16161e",
    "fg": "#c8d3f5",
    "comment": "#6c7599",
    "muted": "#565f89",
    "blue": "#7aa2f7",
    "purple": "#bb9af7",
    "cyan": "#7dcfff",
    "teal": "#73daca",
    "green": "#9ece6a",
    "yellow": "#e0af68",
    "orange": "#ff9e64",
    "red": "#f7768e"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:purple",
          "template": "\uf186 "
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:blue",
          "properties": {
            "macos": "\uf179",
            "linux": "\uf17c",
            "windows": "\ue70f",
            "wsl": "\ue712"
          },
          "template": "{{ if .WSL }}{{ .Icon }} on {{ end }}{{ .Icon }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:cyan",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 2,
            "folder_icon": "\uef81 ",
            "home_icon": "\uf015 "
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:teal",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if gt .Behind 0 }}p:orange{{ end }}"
          ],
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true
          },
          "template": "on {{ .UpstreamIcon }} {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} \u2726{{ end }}{{ if gt .StashCount 0 }} \uf692{{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:comment",
          "properties": {
            "threshold": 500,
            "style": "round"
          },
          "template": "\uf252 {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "{{ if gt .Code 0 }}\u2717{{ else }}\u276f{{ end }} "
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:muted",
    "template": "\u276f "
  },
  "secondary_prompt": {
    "foreground": "p:muted",
    "template": "\u276f "
  }
}
